# Read only by the Netlify serverless function (netlify/functions/wish.mjs),
# never by the browser. Do NOT add a VITE_ prefix to these — that prefix is
# what makes Vite inline a value into the public JS bundle.
#
# Local use: `netlify dev` picks these up from this file's real counterpart,
# `.env` (gitignored). In production set them under
# Site configuration -> Environment variables in the Netlify dashboard.
WISHES_BOT_TOKEN=your-telegram-bot-token
WISHES_CHAT_ID=your-telegram-chat-id
